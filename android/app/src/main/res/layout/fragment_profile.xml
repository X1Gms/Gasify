<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit"
        android:textSize="28sp"
        android:textColor="@color/primary"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_marginHorizontal="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:outlineSpotShadowColor="@color/shadow_color"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/background"
        app:cardCornerRadius="20dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:paddingTop="64dp">

            <!-- Email Icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_person"
                app:tint="@color/primary" />

            <!-- Email Input -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextFullName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/fullName"
                android:imeOptions="actionNext"
                android:inputType="textPersonName"
                android:minHeight="0dp"
                android:padding="0dp"
                android:textColor="@color/foreground"
                android:textSize="16sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_marginHorizontal="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/background"
        app:cardPreventCornerOverlap="false"
        android:layout_marginBottom="22dp"
        app:cardUseCompatPadding="true"
        android:outlineSpotShadowColor="@color/shadow_color">

        <LinearLayout
            android:paddingTop="64dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Email Icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_email"
                app:tint="@color/primary"
                android:layout_marginEnd="12dp" />

            <!-- Email Input -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textEmailAddress"
                android:hint="@string/email"
                android:textSize="16sp"
                android:textColor="@color/foreground"
                android:background="@null"
                android:padding="0dp"
                android:minHeight="0dp"
                android:imeOptions="actionNext" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <ImageView
        android:id="@+id/infoImg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end"
        android:layout_marginRight="36dp"
        app:tint="@color/foreground"
        app:srcCompat="@drawable/ic_info" />

    <com.google.android.material.card.MaterialCardView
        android:layout_marginHorizontal="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardCornerRadius="20dp"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="@color/background"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        android:outlineSpotShadowColor="@color/shadow_color">

        <LinearLayout
            android:paddingTop="64dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Lock Icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/primary"
                android:layout_marginEnd="12dp" />

            <!-- Password Input -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:hint="@string/password"
                android:textSize="16sp"
                android:textColor="@color/foreground"
                android:background="@null"
                android:padding="0dp"
                android:minHeight="0dp"
                android:imeOptions="actionDone" />

            <!-- Password Toggle (Eye Icon) -->
            <ImageView
                android:id="@+id/imageViewPasswordToggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/primary"
                android:layout_marginStart="12dp"
                android:contentDescription="Toggle password visibility" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        app:cardElevation="8dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/background"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        android:outlineSpotShadowColor="@color/shadow_color">

        <LinearLayout
            android:paddingTop="64dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Lock Icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/primary"
                android:layout_marginEnd="12dp" />

            <!-- Password Input -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextConPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:hint="@string/conPassword"
                android:textSize="16sp"
                android:textColor="@color/foreground"
                android:background="@null"
                android:padding="0dp"
                android:minHeight="0dp"
                android:imeOptions="actionDone" />

            <!-- Password Toggle (Eye Icon) -->
            <ImageView
                android:id="@+id/imageViewConPasswordToggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/primary"
                android:layout_marginStart="12dp"
                android:contentDescription="Toggle password visibility" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <Button
        android:layout_marginTop="50dp"
        android:id="@+id/buttonEdit"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="@string/edit"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/primary_button_background"
        android:textColor="@color/primary_foreground"
        android:textAllCaps="false"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="38dp" />
    <Button
        android:layout_marginHorizontal="38dp"
        android:layout_marginTop="25dp"
        android:id="@+id/buttonDel"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="@string/delete"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/primary_button_background"
        android:textColor="@color/primary_foreground"
        android:textAllCaps="false"
        android:layout_marginBottom="100dp" />
</LinearLayout>
</ScrollView>