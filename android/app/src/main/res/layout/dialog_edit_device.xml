<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/dialog_background">

    <!-- Close Button -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_close"
        android:padding="4dp"
        app:tint="@color/foreground"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Editar Dispositivo"
        android:textColor="@color/foreground"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Device Name Input -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/card"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:outlineSpotShadowColor="@color/shadow_color">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_device"
                app:tint="@color/primary"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDeviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nome do Dispositivo"
                android:textSize="16sp"
                android:textColor="@color/foreground"
                android:textColorHint="@color/card_foreground"
                android:background="@null"
                android:padding="0dp"
                android:minHeight="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Serial Number Input (Disabled) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSerialNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/disabled"
        app:layout_constraintTop_toBottomOf="@id/cardDeviceName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:outlineSpotShadowColor="@color/shadow_color">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_barcode"
                app:tint="@color/disabled_foreground"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSerialNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EAFC26EF"
                android:textSize="16sp"
                android:textColor="@color/disabled_foreground" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Country Dropdown -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCountry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/primary"
        app:layout_constraintTop_toBottomOf="@id/cardSerialNumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:outlineSpotShadowColor="@color/shadow_color">

        <LinearLayout
            android:id="@+id/countryDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_south_america"
                app:tint="@color/primary_foreground"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvSelectedCountry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Espanha"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_foreground" />

            <ImageView
                android:id="@+id/arrowCountry"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_forward_ios"
                app:tint="@color/primary_foreground"
                android:rotation="90" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Country List (Hidden initially) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCountryList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/card"
        app:layout_constraintTop_toBottomOf="@id/cardCountry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp">

            <LinearLayout
                android:id="@+id/countryListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Address Input -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/card"
        app:layout_constraintTop_toBottomOf="@id/cardCountryList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:outlineSpotShadowColor="@color/shadow_color">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_work"
                app:tint="@color/primary"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Morada"
                android:textSize="16sp"
                android:textColor="@color/foreground"
                android:textColorHint="@color/card_foreground"
                android:background="@null"
                android:padding="0dp"
                android:minHeight="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Postal Code Input -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPostalCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/card"
        app:layout_constraintTop_toBottomOf="@id/cardAddress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:outlineSpotShadowColor="@color/shadow_color">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_work"
                app:tint="@color/primary"
                android:layout_marginEnd="12dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextPostalCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Código Postal"
                android:textSize="16sp"
                android:textColor="@color/foreground"
                android:textColorHint="@color/card_foreground"
                android:background="@null"
                android:padding="0dp"
                android:minHeight="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Edit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEdit"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Editar"
        android:textColor="@color/primary_foreground"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardPostalCode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>