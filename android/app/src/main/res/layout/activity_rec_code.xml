<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ScrollView para o formulário -->
    <ScrollView
        android:id="@+id/scrollViewForm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_marginVertical="20dp"
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:srcCompat="@drawable/login_image" />

                <!-- Welcome Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/insertCode"
                        android:textSize="28sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/six_digit"
                        android:textSize="16sp"
                        android:textColor="@color/muted_foreground"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Email Input with Icon and Shadow -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/background"
                    app:cardPreventCornerOverlap="false"
                    android:layout_marginBottom="10dp"
                    app:cardUseCompatPadding="true"
                    android:outlineSpotShadowColor="@color/shadow_color">

                    <LinearLayout
                        android:paddingTop="64dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <!-- Email Icon -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_key"
                            android:tint="@color/primary"
                            android:layout_marginEnd="12dp" />

                        <!-- Email Input -->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="text"
                            android:hint="@string/code"
                            android:textSize="16sp"
                            android:textColor="@color/foreground"
                            android:background="@null"
                            android:padding="0dp"
                            android:minHeight="0dp"
                            android:imeOptions="actionNext" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="375dp"
                android:orientation="vertical"
                android:background="@drawable/shape_rectangle_login">

                <LinearLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Login Button -->
                    <Button
                        android:id="@+id/buttonLogin"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:text="@string/authenticate"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/primary_button_background"
                        android:textColor="@color/primary_foreground"
                        android:textAllCaps="false"
                        android:layout_marginBottom="16dp"
                        android:layout_marginHorizontal="8dp" />

                    <!-- Register Link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center">

                        <TextView
                            android:id="@+id/noAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/rememberNow"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_marginLeft="4dp"
                            android:id="@+id/textViewLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/login"
                            android:textSize="16sp"
                            android:textColor="@color/primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>