    "/users/me/devices/{id}": {
      "get": {
        "summary": "Get device details",
        "description": "Retrieve device details, current sensor readings (cards), and historical data (charts).",
        "tags": ["Users"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the device",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "range",
            "in": "query",
            "description": "Data range for charts (hour, week, fortnight, month)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["hour", "week", "fortnight", "month"],
              "default": "hour"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Device details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDeviceDetailsResponse"
